# Copy to .env and fill in. Never commit .env.

# Google OAuth (Web application client). Needed for Gmail; Drive works with it too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
SANDBOX_EMAIL=

# Drive without OAuth: API key + a folder shared as "Anyone with the link"
DRIVE_API_KEY=
DRIVE_FOLDER_ID=

# WhatsApp Cloud API webhook
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_REQUIRE_SIGNATURE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
SELECTED_GROUPS_FILE=config/selected_groups.json

# AI (optional: without a key, keyword rules and record-only answers are used)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest

# Analysis
REFERENCE_DATE=
UNANSWERED_DAYS=5

# Storage
DATABASE_PATH=data/unsilo.db
OUTPUT_DIR=outputs

